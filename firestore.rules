rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Menu public en lecture pour tout le monde ;
    // écriture réservée aux utilisateurs authentifiés (l'admin).
    match /products/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Refuse tout le reste par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
